{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tagg-lobby-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "durable_objects": {
    "bindings": [
      {
        "name": "LOBBIES",
        "class_name": "Lobby"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Lobby"]
    }
  ]
}
